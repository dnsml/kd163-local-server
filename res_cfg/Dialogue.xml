<?xml version="1.0" encoding="utf-8" ?>
<Dialogue>
<item id="10147" dialogue_sence="1" whos_in_sence="" prev_step="" next_step="10148" contents="当年仙魔大战，众仙勇斗魔君，混战中，天穹被划破，这裂缝就称为天之痕。" whos_speaking="2,20001" head_name="九天玄女" head_effect="2" head_res="assets/npcs/n_jiutianxuannv_face.png" head_position="" arrowHead="" position=""/>
<item id="10148" dialogue_sence="1" whos_in_sence="" prev_step="10147" next_step="10149" contents="你身为女娲后人，意欲补天，却不慎中了魔君邪咒，落入人界轮回。" whos_speaking="2,20001" head_name="九天玄女" head_effect="2" head_res="assets/npcs/n_jiutianxuannv_face.png" head_position="" arrowHead="" position=""/>
<item id="10149" dialogue_sence="1" whos_in_sence="" prev_step="10148" next_step="" contents="原来…我前世真的是神仙？" whos_speaking="0,0" head_name="$player$" head_effect="1" head_res="$player$" head_position="" arrowHead="" position=""/>
<item id="10150" dialogue_sence="1" whos_in_sence="" prev_step="" next_step="10151" contents="$player$，你当年只身冲破魔界大军的英姿，老夫一直念念不忘啊。" whos_speaking="2,20002" head_name="太虚星君" head_effect="2" head_res="assets/npcs/n_taishanglaojun_face.png" head_position="" arrowHead="" position=""/>
<item id="10151" dialogue_sence="1" whos_in_sence="" prev_step="10150" next_step="10152" contents="星君过誉了，守护仙界，是我等的天命。" whos_speaking="0,0" head_name="$player$" head_effect="1" head_res="$player$" head_position="" arrowHead="" position=""/>
<item id="10152" dialogue_sence="1" whos_in_sence="" prev_step="10151" next_step="" contents="好！这补天的重担，老夫相信你能扛起！" whos_speaking="2,20002" head_name="太虚星君" head_effect="2" head_res="assets/npcs/n_taishanglaojun_face.png" head_position="" arrowHead="" position=""/>
<item id="10153" dialogue_sence="1" whos_in_sence="" prev_step="" next_step="10154" contents="其实老夫最担心的不是这些作乱的小妖小魔，而是灵气持续从天之痕逸散的后果…" whos_speaking="2,20031" head_name="太乙真人" head_effect="2" head_res="assets/npcs/n_xiaoyaozi_face.png" head_position="" arrowHead="" position=""/>
<item id="10154" dialogue_sence="1" whos_in_sence="" prev_step="10153" next_step="10155" contents="真人为何会这么想？" whos_speaking="0,0" head_name="$player$" head_effect="1" head_res="$player$" head_position="" arrowHead="" position=""/>
<item id="10155" dialogue_sence="1" whos_in_sence="" prev_step="10154" next_step="10156" contents="若不能及时补上天之痕，仙界灵气失散过多，就会重归盘古开天时的混沌之态！必然生灵涂炭…" whos_speaking="2,20031" head_name="太乙真人" head_effect="2" head_res="assets/npcs/n_xiaoyaozi_face.png" head_position="" arrowHead="" position=""/>
<item id="10156" dialogue_sence="1" whos_in_sence="" prev_step="10155" next_step="10157" contents="你身上担子如此之重，老夫须要加快传授你生平绝学，才能令你更快成长。" whos_speaking="2,20031" head_name="太乙真人" head_effect="2" head_res="assets/npcs/n_xiaoyaozi_face.png" head_position="" arrowHead="" position=""/>
<item id="10157" dialogue_sence="1" whos_in_sence="" prev_step="10156" next_step="10158" contents="真人对我如此重托，在下必不能辜负。" whos_speaking="0,0" head_name="$player$" head_effect="1" head_res="$player$" head_position="" arrowHead="" position=""/>
<item id="10158" dialogue_sence="1" whos_in_sence="" prev_step="10157" next_step="" contents="果真是女娲后人，才有这般担当。" whos_speaking="2,20031" head_name="太乙真人" head_effect="2" head_res="assets/npcs/n_xiaoyaozi_face.png" head_position="" arrowHead="" position=""/>
<item id="10159" dialogue_sence="1" whos_in_sence="" prev_step="" next_step="10160" contents="伏羲琴是上古神器，其中的神机能让你血脉之内的灵力再度复苏。" whos_speaking="2,20053" head_name="伏羲掌门" head_effect="2" head_res="assets/npcs/m_head_yuboya.png" head_position="" arrowHead="" position=""/>
<item id="10160" dialogue_sence="1" whos_in_sence="" prev_step="10159" next_step="10161" contents="伏羲琴竟然有这样强的效力？" whos_speaking="0,0" head_name="$player$" head_effect="1" head_res="$player$" head_position="" arrowHead="" position=""/>
<item id="10161" dialogue_sence="1" whos_in_sence="" prev_step="10160" next_step="10162" contents="你只要每日抚琴演奏，日久自然知晓其中效果！" whos_speaking="2,20053" head_name="伏羲掌门" head_effect="2" head_res="assets/npcs/m_head_yuboya.png" head_position="" arrowHead="" position=""/>
<item id="10162" dialogue_sence="1" whos_in_sence="" prev_step="10161" next_step="10163" contents="当然，演奏修为至一定的境界，就可以对伏羲琴进行调音，更能装备琴技，到达巅峰状态！" whos_speaking="2,20053" head_name="伏羲掌门" head_effect="2" head_res="assets/npcs/m_head_yuboya.png" head_position="" arrowHead="" position=""/>
<item id="10163" dialogue_sence="1" whos_in_sence="" prev_step="10162" next_step="10164" contents="记住，调琴的天音蚕丝是仙界珍稀之物，你需要留意多加搜集，才能在调琴中得心应手" whos_speaking="2,20053" head_name="伏羲掌门" head_effect="2" head_res="assets/npcs/m_head_yuboya.png" head_position="" arrowHead="" position=""/>
<item id="10164" dialogue_sence="1" whos_in_sence="" prev_step="10163" next_step="" contents="这么神奇，我一定要试试！" whos_speaking="0,0" head_name="$player$" head_effect="1" head_res="$player$" head_position="" arrowHead="" position=""/>
</Dialogue>