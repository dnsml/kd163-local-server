# ============================================================
# KD163 本地服 —— 传 GitHub 前必须遵守的排除规则
# 目标：仓库只含「服务端源码 + 配置表 + 文档」，不含证书/存档/日志/大资源
# ============================================================

# ---- 1. 证书与私钥 ----
# exact.pem 是改包 APK 内嵌的信任根。为了让「clone 下来直接能跑」，这一对已入库
# （见文件末尾的例外规则）；其余证书仍不入库。
*.pem
*.key

# ---- 2. 改包产物 / 二进制 ----
*.apk
*.dex
*.so
*.jar
patch/*.apk

# ---- 2b. 分发用的打包产物 ----
# 2026-11-24 21:16 出现过「安装包+资源包+账号密码.zip」(486MB) 及同名解压目录(465MB)：
# 内容是 APK + 资源包 + 账号，属于网盘分发物，超 GitHub 单文件 100MB 上限，绝不入库。
patch/*.zip
patch/*安装包*
patch/*账号密码*

# ---- 3. 玩家存档（含账号、等级、背包、任务进度）----
player_state*.json
state_before_probe.json
# 2026-11-26 起存档默认在 SQLite（state_store.py）：server_state.db 一行一个账号，
# 和 player_state*.json 一样是玩家数据，绝不入库。WAL/SHM 是它的临时文件。
server_state.db
server_state.db-*
# 白名单/账号密码（哈希）与后台管理员密码都按部署环境维护，不进仓库
accounts.json
admin.json
*.db-wal
*.db-shm

# ---- 4. 日志与抓包 ----
# 日志是核心分析资料（真服/他服完整包序），.log 全部保留；
# 同目录下的截图 / APK / raw.bin 是冗余产物，排除。
logs/*.png
logs/*.jpg
logs/*.apk
logs/*.bin
logs/shot*
logs/*.json
!logs/*.log
!logs/*.bak_*

# 抓包日志的冗余副本（2026-11-24 核查：以下文件的内容都能在 relay.log 里
# 原样找到——bak_1233 是它前 19688 行的前缀副本，relay_out.log 是 13:48 会话的
# 重定向副本，其余两个只有一行启动记录）。判据可复现：
#   python -c "m=open('logs/relay.log','rb').read();print(open('logs/relay.log.bak_1233','rb').read() in m)"
# 文件本地保留，只是不进版本库，免得「14MB 抓包」里混着 3.5MB 重复。
logs/relay.log.bak_*
logs/relay_out.log
logs/relay_out.txt
logs/relay_run.out
logs/relay_19001.log
# 同理：server_before_fix / server_prev_* 都是「改代码前 cp 一份」的产物，
# server.log 是追加写的，这些快照被它完整包含（md5/包含关系已核）。
logs/server_before*.log
logs/server_prev*.log
# 服务端启动时的 stdout/stderr（Windows 控制台是 GBK，而 log() 写 server.log 是 UTF-8，
# 两者混进同一个文件会出半行乱码 —— 所以进程输出单独落这里，不进库）。
logs/server_run.out
# 回归脚本临时把测试输出重定向到这里（t_exit.out / admin_probe.out 之类），属临时产物。
logs/*.out
# 排查后台时 curl 落下来的响应头/页面副本（h.txt、admin_index.html 等）
logs/h.txt
logs/*.html
logs/*.txt

# ---- 5. 本地工作区 ----
# 存档快照（save_state 每 10 分钟一份）是玩家数据，不是代码，绝不进库。
backups/
# 注意必须写 work/*（而不是 work/）：整目录被排除时，子项的 ! 例外不生效，
# 会导致 README 里引用的探针脚本在 clone 后根本不存在。
# 这里只保留可复用的脚本，截图/输出/log 全部排除。
work/*
!work/*.py
!work/*.sh
!work/*.md

# ---- 6. 游戏资源与工具链（3GB，绝不入库）----
tools/
srvres/
builtin/
res_x/
res_update/
res_wing/
so/
apk_x/
mirror/assets/configure/*.mpkg

# ---- 7. 截图（调试过程产物，不入库；本地保留）----
/*.png
/*.jpg
/*.jpeg
截图_*.jpg
s_*.png
screen*.png
b.png
b_s.png
e.png
e_s.png
f.png

# ---- 7b. 一次性残留（grep 输出、资源索引、uiautomator dump 等）----
/S
/b6.bin
/live.idx
/ui.xml
/proxy.log
/dex_strings.txt
*.bak
*.bak_*
*.bak2
/*.py.bak*
player_state*.json.bak*

# ---- 8. Python ----
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ---- 9. 例外：保证 clone 下来直接能跑 ----
# 服务端 /auth 必须用这张证书，且它必须与客户端 APK 内嵌的信任根一致，
# 不能靠 gen_cert_exact.py 现生成（现生成的与 APK 不匹配，客户端照样连不上）。
!patch/exact.pem
!patch/exact.key

# 运行日志，不入库（每跑一次 +1000 行，纯噪音）
logs/server.log

# 客户端崩溃转储（minidump，多为空壳，无分析价值）
logs/*.dmp

# 本地调试用临时服务日志（work/test_*.py 手动起 9112 时产生）
logs/test*.log
