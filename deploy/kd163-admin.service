[Unit]
Description=kd163 admin panel (127.0.0.1:8899)
After=network.target kd163-game.service

[Service]
Type=simple
User=kd163
Group=kd163
WorkingDirectory=/opt/kd163
Environment=PYTHONIOENCODING=utf-8
# 只绑本机：远程访问用 SSH 隧道，或用 Nginx 反代 + HTTPS。
Environment=KD163_ADMIN_HOST=127.0.0.1
# 走 Nginx 反代（后台看到的来源是 127.0.0.1）时打开这一行，强制登录：
#Environment=KD_ADMIN_REQUIRE=1
ExecStart=/usr/bin/python3 admin_server.py 8899
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
