[Unit]
Description=kd163 resource server (port 80)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kd163
Group=kd163
WorkingDirectory=/opt/kd163
Environment=PYTHONIOENCODING=utf-8
# server-list.xml 里广播给客户端的地址：公网 IP 或域名
Environment=KD163_HOST=127.0.0.1
ExecStart=/usr/bin/python3 local_http.py 80 $KD163_HOST
Restart=always
RestartSec=3
# 非 root 绑 80 端口
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
